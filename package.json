{
  "name": "@smjr3/mermaid-editor",
  "version": "0.2.1",
  "description": "Customizable distribution of Mermaid Live Editor, delivered as an npm package and buildable into a static site. Unofficial derivative of mermaid-js/mermaid-live-editor.",
  "keywords": [
    "diagram",
    "editor",
    "mermaid",
    "static-site",
    "svelte"
  ],
  "homepage": "https://github.com/smjr3/mermaid-editor#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smjr3/mermaid-editor.git"
  },
  "bugs": {
    "url": "https://github.com/smjr3/mermaid-editor/issues"
  },
  "author": "smjr3",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    ".upstream-version.json",
    ".env",
    ".node-version",
    ".prettierignore",
    ".prettierrc",
    "CLAUDE.md",
    "NOTICE",
    "README.upstream.md",
    "THIRD-PARTY-LICENSES.md",
    "components.json",
    "docs-dev/",
    "eslint.config.js",
    "playwright.config.ts",
    "scripts/",
    "src/",
    "!src/lib/vendor-icons/",
    "static/",
    "svelte.config.js",
    "tests/",
    "tsconfig.json",
    "vite.config.js",
    "vite.embed.config.js"
  ],
  "license": "MIT",
  "scripts": {
    "dev": "vite build --config vite.embed.config.js && vite dev",
    "dev:force": "node scripts/dev-force.js",
    "dev:test": "pnpm dev",
    "build": "node scripts/copy-legal-files.js && node scripts/fetch-icon-packs.js && vite build --config vite.embed.config.js && vite build",
    "build:embed": "vite build --config vite.embed.config.js",
    "build:pages": "node scripts/prepare-pages.js",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check --cache . && eslint .",
    "lint:fix": "prettier --write --cache . && eslint --fix .",
    "format": "prettier --write --cache .",
    "pre-commit": "lint-staged",
    "postinstall": "(husky || node -e \"process.exit(0)\") && svelte-kit sync && (git config blame.ignoreRevsFile .git-blame-ignore-revs || node -e \"process.exit(0)\")",
    "test:unit": "vitest",
    "test:unit:ui": "vitest --ui",
    "test:unit:coverage": "vitest run --coverage",
    "test": "pnpm test:unit && pnpm test:e2e",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@iconify-json/logos": "^1.2.14",
    "@iconify-json/material-symbols": "^1.2.93",
    "@iconify-json/mdi": "^1.2.3",
    "@playwright/test": "1.63.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/hammerjs": "^2.0.46",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.19.0",
    "@types/pako": "2.0.4",
    "@vitest/coverage-v8": "^5.0.2",
    "@vitest/ui": "^5.0.2",
    "bits-ui": "^2.19.3",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.4",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-sort-keys": "^2.3.5",
    "eslint-plugin-svelte": "^3.23.0",
    "eslint-plugin-unicorn": "^76.0.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.1",
    "lint-staged": "^17.6.0",
    "lucide-svelte": "^1.0.1",
    "paneforge": "1.0.2",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "svelte-preprocess": "^6.0.5",
    "svelte-sonner": "^1.2.1",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "unplugin-icons": "^24.0.0",
    "vite": "^8.3.1",
    "vite-plugin-devtools-json": "^1.1.0",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@fontsource-variable/recursive": "^5.3.0",
    "@fsegurai/codemirror-theme-vscode-dark": "^6.2.8",
    "@fsegurai/codemirror-theme-vscode-light": "^6.2.8",
    "@iconify-json/carbon": "^1.2.28",
    "@iconify-json/clarity": "^1.2.4",
    "@iconify-json/devicon": "^1.2.68",
    "@iconify-json/eos-icons": "^1.2.4",
    "@iconify-json/flat-color-icons": "^1.2.3",
    "@iconify-json/fluent": "^1.2.59",
    "@iconify-json/fluent-color": "^1.2.21",
    "@iconify-json/lucide": "^1.2.139",
    "@iconify-json/simple-icons": "^1.2.98",
    "@iconify-json/tabler": "^1.2.41",
    "@mermaid-js/examples": "^2.0.0",
    "@mermaid-js/layout-tidy-tree": "^1.0.1",
    "@mermaid-js/mermaid-zenuml": "^1.0.1",
    "codemirror": "^6.0.2",
    "dayjs": "^1.11.23",
    "dompurify": "^3.4.16",
    "hammerjs": "^2.0.8",
    "js-base64": "3.9.4",
    "lodash-es": "^4.18.1",
    "mermaid": "^12.1.0",
    "mode-watcher": "^1.1.0",
    "monaco-editor": "0.57.0",
    "pako": "2.1.0",
    "plausible-tracker": "^0.3.9",
    "random-word-slugs": "0.1.7",
    "svg-pan-zoom": "3.6.2",
    "svg2roughjs": "^3.2.3",
    "uuid": "14.0.2"
  },
  "lint-staged": {
    "*.{ts,svelte,js,css,md,json}": [
      "prettier --plugin-search-dir=. --write",
      "eslint "
    ]
  },
  "engines": {
    "node": ">=24.16.0"
  },
  "packageManager": "pnpm@10.34.5+sha512.a4ee05f2f73658255bd6a89859c065a45c28a57daefae2c893a168ee2b73168c37b91e83e57ea67654ad03f03031746430e8bce38e362e042605fb8abc80192e",
  "overrides": {
    "monaco-editor": {
      "dompurify": "3.4.16"
    },
    "mermaid": {
      "katex": "0.18.11"
    }
  },
  "pnpm": {
    "overrides": {
      "monaco-editor>dompurify": "3.4.16",
      "mermaid>katex": "0.18.11"
    },
    "onlyBuiltDependencies": [
      "deasync",
      "esbuild",
      "svelte-preprocess"
    ],
    "ignoredBuiltDependencies": [
      "vue-demi"
    ]
  }
}
