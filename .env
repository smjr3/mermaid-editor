MERMAID_DOMAIN=''
MERMAID_BASE_PATH=''
MERMAID_DOCS_URL='https://mermaid.js.org'
# UI language. 'ja' or 'en'; 'en' restores upstream's original wording.
MERMAID_LOCALE='ja'
MERMAID_ANALYTICS_URL=''
MERMAID_RENDERER_URL=''
MERMAID_KROKI_RENDERER_URL=''
MERMAID_IS_ENABLED_MERMAID_CHART_LINKS='false'
MERMAID_IS_ENABLED_AI_FEATURES='false'
MERMAID_IS_ENABLED_COMMUNITY_LINKS='false'
MERMAID_HIDE_PRIVACY_POLICY='true'
# Extra icon packs this deployment hosts, as comma-separated prefix=url pairs, e.g.
# 'azure=./icon-packs/azure.json'. Relative URLs resolve against the site. See docs-dev/ICONS.md.
MERMAID_ICON_PACKS=''

# cp .env .env.local to make local changes
