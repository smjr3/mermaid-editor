MERMAID_DOMAIN=''
MERMAID_BASE_PATH=''
MERMAID_DOCS_URL='https://mermaid.js.org'
# UI language. 'ja' or 'en'; 'en' restores upstream's original wording.
MERMAID_LOCALE='ja'
MERMAID_ANALYTICS_URL=''
MERMAID_RENDERER_URL=''
MERMAID_KROKI_RENDERER_URL=''
MERMAID_IS_ENABLED_MERMAID_CHART_LINKS='false'
MERMAID_IS_ENABLED_AI_FEATURES='false'
MERMAID_IS_ENABLED_COMMUNITY_LINKS='false'
MERMAID_HIDE_PRIVACY_POLICY='true'
# 'false' leaves the logo icon sets (logos, simple-icons, devicon) out of the build and strips
# brand icons from the generic sets. See docs-dev/ICONS.md.
MERMAID_BUNDLE_LOGOS='true'
# Extra icon packs this deployment hosts, as comma-separated prefix=url pairs, e.g.
# 'azure=./icon-packs/azure.json'. Relative URLs resolve against the site. See docs-dev/ICONS.md.
MERMAID_ICON_PACKS=''
# The colour buttons of the Colours card, as comma-separated border colours, e.g. a company
# palette '#003366,#e60012,#00a040'. Each gets a light fill to match. Empty keeps the built-in eight.
MERMAID_COLOR_PRESETS=''
# 'true' makes the site request nothing outside itself: no config-schema download for the
# config editor's completions, no Font Awesome stylesheet reference in exported SVGs, and no
# loading of diagrams from gists or URLs. Links that open other sites on a click stay.
MERMAID_OFFLINE='true'

# cp .env .env.local to make local changes
